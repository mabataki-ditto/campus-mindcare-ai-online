generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==================== 用户模块 ====================

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  nickname  String?  @db.VarChar(50)
  email     String?  @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  gender    Int?     @default(0)   // 0=未知, 1=男, 2=女
  avatar    String?  @db.VarChar(500)
  userType  Int      @default(1)   // 1=普通用户, 2=管理员
  riskLevel Int      @default(0)   // 0=正常, 1=关注, 2=预警, 3=危机
  status    Int      @default(1)   // 1=正常, 0=禁用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    ConsultationSession[]
  diaries     EmotionDiary[]
  alertEvents AlertEvent[]
  userRoles   UserRole[]
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  code      String   @unique @db.VarChar(50)
  desc      String?  @db.VarChar(200)
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserRole[]
  roleMenus RoleMenu[]
}

model Menu {
  id         Int      @id @default(autoincrement())
  parentId   Int?     @default(0)
  name       String   @db.VarChar(50)
  type       Int      @default(1)   // 1=目录, 2=菜单, 3=按钮
  icon       String?  @db.VarChar(100)
  path       String?  @db.VarChar(200)
  component  String?  @db.VarChar(200)
  permission String?  @db.VarChar(100)
  sort       Int      @default(0)
  status     Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roleMenus RoleMenu[]
}

model Department {
  id        Int      @id @default(autoincrement())
  parentId  Int?     @default(0)
  name      String   @db.VarChar(50)
  leader    String?  @db.VarChar(50)
  sort      Int      @default(0)
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  // @map 作用是为字段起一个别名，表示数据库生成的字段名
  userId Int @map("user_id")
  roleId Int @map("role_id")

  //建立关联关系
  // fields：当前模型中的数据
  // references ：关联的模型中的数据

  // user 关联 User 模型，通过 userId 关联
  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RoleMenu {
  roleId Int @map("role_id")
  menuId Int @map("menu_id")

  role Role @relation(fields: [roleId], references: [id])
  menu Menu @relation(fields: [menuId], references: [id])

  @@id([roleId, menuId])
}

// ==================== 心理咨询模块 ====================

model ConsultationSession {
  id           Int      @id @default(autoincrement())
  sessionId    String   @unique @db.VarChar(100)
  userId       Int
  sessionTitle String?  @db.VarChar(200)
  status       String   @default("ACTIVE") @db.VarChar(20) // TEMP, ACTIVE, ENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  messages ChatMessage[]
  emotions SessionEmotion[]
  alerts   AlertEvent[]
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  sessionId  Int
  senderType Int      // 1=用户, 2=AI
  content    String   @db.Text
  createdAt  DateTime @default(now())

  session ConsultationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model SessionEmotion {
  id                     Int      @id @default(autoincrement())
  sessionId              Int
  primaryEmotion         String   @db.VarChar(20)
  emotionScore           Int      @default(50)  // 0-100
  isNegative             Boolean  @default(false)
  riskLevel              Int      @default(0)   // 0=正常, 1=关注, 2=预警, 3=危机
  riskDescription        String?  @db.VarChar(500)
  suggestion             String?  @db.VarChar(500)
  improvementSuggestions String?  @db.Text      // JSON数组字符串
  createdAt              DateTime @default(now())

  session ConsultationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

// ==================== 情绪预警模块 ====================

model AlertEvent {
  id         Int       @id @default(autoincrement())
  userId     Int
  sessionId  Int?
  riskLevel  Int       // 1=关注, 2=预警, 3=危机
  reason     String    @db.VarChar(500)
  handled    Boolean   @default(false)
  handlerId  Int?
  handleNote String?   @db.VarChar(500)
  handledAt  DateTime?
  createdAt  DateTime  @default(now())

  user    User                 @relation(fields: [userId], references: [id])
  session ConsultationSession? @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([riskLevel])
  @@index([handled])
}

// ==================== 情绪日记模块 ====================

model EmotionDiary {
  id              Int      @id @default(autoincrement())
  userId          Int
  moodScore       Int      // 1-10
  moodLabel       String   @db.VarChar(20)
  dominantEmotion String?  @db.VarChar(20)
  emotionTriggers String?  @db.VarChar(200)
  content         String?  @db.Text
  sleepQuality    Int?     // 1-5
  stressLevel     Int?     // 1-5
  diaryDate       DateTime @default(now())
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([diaryDate])
}

// ==================== 知识库模块 ====================

model KnowledgeCategory {
  id           Int      @id @default(autoincrement())
  parentId     Int?     @default(0)
  categoryName String   @db.VarChar(50)
  sort         Int      @default(0)
  status       Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles KnowledgeArticle[]
}

model KnowledgeArticle {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(200)
  content    String   @db.LongText
  summary    String?  @db.VarChar(500)
  coverImage String?  @db.VarChar(500)
  categoryId Int
  authorName String?  @db.VarChar(50)
  tags       String?  @db.VarChar(500) // 逗号分隔
  readCount  Int      @default(0)
  status     Int      @default(0)      // 0=草稿, 1=已发布, 2=已下线
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category KnowledgeCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
}
