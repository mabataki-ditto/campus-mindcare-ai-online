# ============================================================
# 校园AI心理陪伴平台 — 环境变量模板
# 使用方式：复制此文件为 .env 并填写真实值
# 命令：cp .env.example .env  (Linux/Mac)
#       Copy-Item .env.example .env  (Windows PowerShell)
# ============================================================

# ==================== MySQL 数据库配置 ====================
# MySQL root 用户密码（生产环境务必使用强密码）
MYSQL_ROOT_PASSWORD=your_strong_password_here

# 数据库名称（会自动创建）
MYSQL_DATABASE=ai_psychological

# ==================== JWT 认证配置 ====================
# JWT 密钥，用于用户登录 token 的签发和验证
# 建议使用 32 位以上的随机字符串，可用命令生成：openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# ==================== DeepSeek AI 配置 ====================
# DeepSeek API Key（在 https://platform.deepseek.com 申请）
# 留空则 AI 对话功能不可用，其他功能正常
DEEPSEEK_API_KEY=sk-your_api_key_here

# DeepSeek API 基础地址（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 使用的模型名称（deepseek-chat 为对话模型，支持 Function Calling）
DEEPSEEK_MODEL=deepseek-chat

# ==================== Webhook 自动部署配置 ====================
# Webhook 密码：Gitee Webhook 配置里填同样的值，用于验证请求合法性
# 生成随机字符串：openssl rand -hex 16
WEBHOOK_SECRET=your_webhook_secret_here

# Webhook 服务监听端口（需要在腾讯云安全组放行）
WEBHOOK_PORT=9000
